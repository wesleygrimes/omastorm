review/
docs/media/*
!docs/media/README.md

# Wrangler local state (site/ deploys)
.wrangler/

# Local working notes, never committed
PLAN.md

# Editor and tool state
.venv/
.agents/
.codex/
__pycache__/
*.qmlc
*.jsc
*.qmlls.ini

# Unpublished sharing copy and legacy derived data, kept local
docs/sharing.md
data/derived/

# Site media, cut from docs/media by the commands in site/README.md
site/take.mp4
site/take-poster.png

# mise per-machine overrides
mise.local.toml
