import QtQuick

// The reviewed 16 px mark, with its original alpha weights and themed ink.
// `size` scales the grid for the brand row without changing the bar mark.
Canvas {
    id: mark
    property color ink: "white"
    property int size: 16
    implicitWidth: size
    implicitHeight: size
    onInkChanged: requestPaint()
    onSizeChanged: requestPaint()
    onWidthChanged: requestPaint()
    onHeightChanged: requestPaint()
    onPaint: {
        var ctx = getContext("2d");
        ctx.reset();
        ctx.fillStyle = ink;
        var s = width / 16;
        var pixels = [[0, 1, 0.35], [0, 2, 0.35], [0, 3, 0.35], [0, 4, 0.35], [0, 5, 0.35], [0, 6, 0.35], [0, 7, 0.35], [0, 8, 0.35], [0, 9, 0.35], [0, 10, 0.35], [0, 11, 0.35], [0, 12, 0.35], [0, 13, 0.35], [0, 14, 0.35], [1, 0, 0.35], [1, 15, 0.35], [2, 0, 0.35], [2, 15, 0.35], [3, 0, 0.35], [3, 5, 0.5], [3, 6, 0.5], [3, 7, 0.5], [3, 8, 0.5], [3, 9, 0.5], [3, 10, 0.5], [3, 15, 0.35], [4, 0, 0.35], [4, 4, 0.5], [4, 11, 0.5], [4, 15, 0.35], [5, 0, 0.35], [5, 3, 0.5], [5, 9, 0.55], [5, 12, 0.5], [5, 15, 0.35], [6, 0, 0.35], [6, 3, 0.5], [6, 8, 0.55], [6, 10, 0.55], [6, 12, 0.5], [6, 15, 0.35], [7, 0, 0.35], [7, 3, 0.5], [7, 7, 0.95], [7, 8, 0.95], [7, 9, 0.55], [7, 12, 0.5], [7, 15, 0.35], [8, 0, 0.35], [8, 3, 0.5], [8, 6, 0.8], [8, 7, 0.95], [8, 8, 0.95], [8, 12, 0.5], [8, 15, 0.35], [9, 0, 0.35], [9, 3, 0.5], [9, 5, 1.0], [9, 6, 1.0], [9, 7, 0.8], [9, 12, 0.5], [9, 15, 0.35], [10, 0, 0.35], [10, 3, 0.5], [10, 4, 0.8], [10, 5, 1.0], [10, 6, 1.0], [10, 12, 0.5], [10, 15, 0.35], [11, 0, 0.35], [11, 3, 0.8], [11, 4, 1.0], [11, 5, 0.8], [11, 11, 0.5], [11, 15, 0.35], [12, 0, 0.35], [12, 2, 0.55], [12, 3, 0.8], [12, 4, 0.8], [12, 5, 0.5], [12, 6, 0.5], [12, 7, 0.5], [12, 8, 0.5], [12, 9, 0.5], [12, 10, 0.5], [12, 15, 0.35], [13, 0, 0.35], [13, 1, 0.55], [13, 3, 0.55], [13, 15, 0.35], [14, 0, 0.35], [14, 2, 0.55], [14, 15, 0.35], [15, 1, 0.35], [15, 2, 0.35], [15, 3, 0.35], [15, 4, 0.35], [15, 5, 0.35], [15, 6, 0.35], [15, 7, 0.35], [15, 8, 0.35], [15, 9, 0.35], [15, 10, 0.35], [15, 11, 0.35], [15, 12, 0.35], [15, 13, 0.35], [15, 14, 0.35]];
        for (var p of pixels) {
            ctx.globalAlpha = p[2];
            ctx.fillRect(p[0] * s, p[1] * s, s, s);
        }
    }
}
